<div class="post-form">
  <% if @post.errors.present? %>
    <div class="error-box">
      <% @post.errors.full_messages.each do |error| %>
        <li class="error-li-text"><%= error %></li>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: @post do |f| %>
    <div class="post-form-into-box">
      <div class="field post-name">
        <%= f.text_field :name, class: "post-name-field", placeholder: "あなたの名前" %>
      </div>
      <div class="field">
        <%= f.submit "作る", class: "registration-button post" %>
      </div>
    </div>
  <% end %>
</div>
