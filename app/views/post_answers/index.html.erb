
<div class="yellow-background-box">
  <p class="already-registration-text"><%= flash[:already_regstration] %></p>
  <div class="answer-share-box">
    <h2 class="hello-name-text">こんにちは <%= @post.name %>さん</h2>
    <h3 class="know-share-text">このリンクを共有して好きな人の名前を知っちゃおう！</h3>
    <div class="link-copy-box">
      <%= button_tag "リンクをコピー", id: "link-copy-btn", class: "ai-find-button" %>
      <%= text_field_tag "", request.url.gsub("answers", ""), id: "link-copy-area" %>
    </div>
    <div class="link-share-sns-box">
      <div class="link-share-button-out-box">
        <a href="https://twitter.com/share?url=<%= request.url.gsub("answers", "") %>&text=あなたの好きな人は誰？ あなたとあなたの好きな人の相性を最新AIで診断します。&hashtags=相性診断" target="_blank">
          <div class="twitter-share-box share-sns-box">
              Twitterでシェア
          </div>
        </a>
      </div>
      <div class="link-share-button-out-box">
        <a href="https://social-plugins.line.me/lineit/share?url=<%= request.url.gsub("answers", "") %>" target="_blank">
          <div class="line-share-box share-sns-box">
            LINEでシェア
          </div>
        </a>
      </div>
      <div class="link-share-button-out-box">
        <a href="http://www.facebook.com/share.php?u=<%= request.url.gsub("answers", "") %>" target="_blank">
          <div class="facebook-share-box share-sns-box">
            Facebookでシェアする
          </div>
        </a>
      </div>
    </div>
  </div>
  <% post_answer_class =  @post.post_answers.exists? ? "" : "empty" %>
  <div class="post-answers-box">
    <div class="post-answers-table-box <%= post_answer_class %>">
      <h1 class="<%= post_answer_class %> display-here-text">友達の回答がありません</h1>
      <table class="friends-like-table">
        <tr>
          <th class="friends-like-title-th">友達の名前</th>
          <th class="friends-like-title-th">好きな人の名前</th>
        </tr>
          <% @post.post_answers.each do |post_answer| %>
            <tr>
              <td class="post-answer-table-td">
                <%= post_answer.answerd_name %>
              </td>
              <td class="post-answer-table-td">
                <%= post_answer.target_name %>
              </td>
            </tr>
          <% end %>
      </table>
    </div>
  </div>
</div>
<script>
  var target_area = document.getElementById("link-copy-area");
  document.getElementById("link-copy-btn").addEventListener("click", function(){
    target_area.select();
    document.execCommand("copy");

  });

  document.addEventListener("copy", function(e){
    e.clipboardData.setData("text/plain", target_area.value);
    e.preventDefault();
    // document.removeEventListener("copy", );
  });

</script>
