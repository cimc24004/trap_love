    <p>あなたの好きな人の名前は<%= @post_answer.post.name %>に送信されました！</p>
  </div>
  <div class="tobipen-image-box">
    <%= image_tag "tobipen", class: "tobipen-image" %>
  </div>
  <div class="lark-create-box">
    <h2 class="lark-your-friends-text">あなたも友達をいたずらできる！</h2>
    <%= link_to "登録する。", root_path %>
  </div>
</div>
